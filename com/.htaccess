# Custom error page: unknown URLs get a branded 404 (status stays 404, page is noindex).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
# Security headers (no effect on how the page looks or loads):
# - nosniff: browsers trust the declared file type (CSS/JS/fonts are served with correct types).
# - Referrer-Policy: other sites see only "ibrooker.com", never full URLs with ?query strings.
# - X-Frame-Options + CSP frame-ancestors: the site cannot be framed by other sites (anti-clickjacking).
# - Permissions-Policy: camera, microphone, geolocation, payment and USB are switched off; the site uses none.
# CSP is limited to frame-ancestors on purpose: the page uses inline JSON-LD and a small inline script.
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
Header set Content-Security-Policy "frame-ancestors 'self'"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
# HSTS (step 1 of 3): browsers remember to use https:// for this host for 1 day.
# No includeSubDomains and no preload on purpose. Raise in steps once verified live:
# 1 day -> 1 week (604800) -> 6 months (15552000). Only browsers on https:// honour it.
Header set Strict-Transport-Security "max-age=86400"
# HTML: always re-check, so content changes show up at once.
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
# CSS/JS: referenced as file.ext?v=N. Cached 7 days.
# RULE: bump ?v= in index.html whenever style.css or story.js changes.
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
# Fonts: cached 1 year and marked immutable (they never change in place).
# RULE: if a font is ever re-subset, save it under a NEW file name (e.g. archivo-2.woff2)
# and update the preload link in index.html and the @font-face rule in style.css.
<FilesMatch "\.woff2$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Images and icons (og.jpg, favicon, touch icon): cached 30 days.
<FilesMatch "\.(jpe?g|png|ico|webp|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# Canonical host: send http:// and www. to https://ibrooker.com/ with one 301,
# so search engines see a single version of each page.
# Host-scoped on purpose (safe if one docroot sits inside the other).
# /.well-known/ is left alone so SSL certificate renewal is never affected.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^(www\.)?ibrooker\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ibrooker.com%{REQUEST_URI} [R=301,L]
</IfModule>
